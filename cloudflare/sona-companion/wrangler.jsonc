{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sona-companion",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "vars": {
    "AUDIENCE": "sona-companion",
    "WORKER_VERSION": "40e9316e",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sona-companion",
      "database_id": "ad090602-83e3-4f27-a907-6564f45d5812",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CIPHERTEXT",
      "bucket_name": "sona-companion-ciphertext",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAINTENANCE",
        "queue": "sona-companion-maintenance",
      },
    ],
    "consumers": [
      {
        "queue": "sona-companion-maintenance",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
