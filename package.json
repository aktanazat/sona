{
  "name": "sona-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build": "bun scripts/cargo-target-dir.ts cargo build --manifest-path src-tauri/Cargo.toml --bin sona --release",
    "build:debug": "bun scripts/cargo-target-dir.ts cargo build --manifest-path src-tauri/Cargo.toml --bin sona",
    "lint:backend": "bun scripts/cargo-target-dir.ts cargo clippy --manifest-path src-tauri/Cargo.toml",
    "lint:anti-slop": "bun scripts/anti-slop-gate.ts",
    "lint:anti-slop:update": "bun scripts/anti-slop-gate.ts --update",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format:scripts": "prettier --write scripts tools/oxlint oxlint.config.ts package.json",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:backend": "bun scripts/cargo-target-dir.ts cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "prepare:agent-hook": "bun scripts/prepare-agent-hook.ts",
    "prepare:cleanup-runtime": "bun scripts/prepare-cleanup-runtime.ts",
    "test:agent-hook-package": "bun test scripts/prepare-agent-hook.test.ts",
    "test:scripts": "bun test scripts",
    "test:mcp": "cd tools/sona-mcp && bun install && bun test",
    "typecheck:mcp": "cd tools/sona-mcp && bun install && bun run typecheck",
    "generate:native-dispatch": "python3 scripts/gen_native_dispatch.py",
    "check:onboarding": "bash scripts/check-onboarding.sh",
    "check:identity": "bun scripts/ci/check-identity.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "oxlint": "1.79.0",
    "prettier": "^3.6.2"
  }
}
