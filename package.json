{
  "name": "sona-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 1420",
    "build": "next build",
    "preview": "bunx serve out",
    "tauri": "bun scripts/cargo-target-dir.ts tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:backend": "cd src-tauri && bun ../scripts/cargo-target-dir.ts cargo clippy",
    "lint:anti-slop": "bun scripts/anti-slop-gate.ts",
    "lint:anti-slop:update": "bun scripts/anti-slop-gate.ts --update",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:backend": "cd src-tauri && bun ../scripts/cargo-target-dir.ts cargo test --lib",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "prepare:agent-hook": "bun scripts/prepare-agent-hook.ts",
    "test:agent-hook-package": "bun test scripts/prepare-agent-hook.test.ts",
    "test:scripts": "bun test scripts",
    "test:mcp": "cd tools/sona-mcp && bun install && bun test",
    "typecheck:mcp": "cd tools/sona-mcp && bun install && bun run typecheck",
    "check:translations": "bun scripts/check-translations.ts",
    "check:identity": "bun scripts/ci/check-identity.ts",
    "postinstall": "bun scripts/check-nix-deps.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.1.1",
    "i18next": "^25.7.2",
    "immer": "^11.1.3",
    "lucide-react": "^0.542.0",
    "motion": "^13.1.1",
    "next": "^16.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.4.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.16",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "oxlint": "1.79.0",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3"
  }
}
